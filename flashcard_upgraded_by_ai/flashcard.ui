  <property name="styleSheet">
   <string notr="true">/* ===== GIAO DIỆN ĐEN &amp; XANH DƯƠNG TỐI GIẢN ===== */

/* TOÀN BỘ CỬA SỔ - Chỉ màu đen */
QMainWindow {
    background-color: #000000;
    font-family: 'Segoe UI', system-ui, sans-serif;
    color: #ffffff;
}

/* Container chính - Linh hoạt */
QWidget#centralwidget {
    background-color: #000000;
    padding: 5px;
}

/* ===== HEADER - Đếm thẻ ===== */
QLabel#labelCounter {
    font-size: 14px;
    font-weight: 500;
    color: #60a5fa; /* Xanh dương sáng */
    background-color: rgba(30, 41, 59, 0.8); /* Xanh than đậm */
    border: 1px solid #1e40af; /* Viền xanh đậm */
    padding: 8px 16px;
    border-radius: 8px;
    text-align: center;
}

/* ===== FLASHCARD CHÍNH ===== */
QLabel#labelFlashcard {
    background-color: #0f172a; /* Xanh đen đậm */
    color: #e2e8f0; /* Trắng xám */
    border: 2px solid #1e3a8a; /* Viền navy */
    border-radius: 12px;
    padding: 30px 20px;
    font-size: 20px;
    font-weight: 500;
    text-align: center;
    /* Cho phép text wrap và co dãn */
    word-wrap: break-word;
}

QLabel#labelFlashcard:hover {
    border-color: #3b82f6; /* Xanh điện khi hover */
    background-color: #1e293b;
}

/* ===== NÚT ĐIỀU KHIỂN - Chỉ 3 nút chính ===== */
QPushButton {
    background-color: #1e3a8a; /* Navy */
    color: white;
    border: 1px solid #3b82f6;
    border-radius: 8px;
    padding: 10px 15px;
    font-size: 14px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #2563eb; /* Xanh sáng hơn */
    border-color: #60a5fa;
}

QPushButton:pressed {
    background-color: #1e40af; /* Xanh đậm hơn */
}

/* Nút Lật thẻ - nổi bật hơn */
QPushButton#btnFlip {
    background-color: #3b82f6; /* Xanh điện */
    font-weight: 600;
    font-size: 15px;
    border: 1px solid #60a5fa;
}

QPushButton#btnFlip:hover {
    background-color: #2563eb;
}

/* ===== NÚT XÓA ===== */
QPushButton#btnDelete {
    background-color: #1e293b; /* Xanh than đậm */
    color: #e2e8f0;
    border: 1px solid #475569;
    border-radius: 8px;
    padding: 8px 15px;
    font-size: 14px;
    font-weight: 500;
}

QPushButton#btnDelete:hover {
    background-color: #334155; /* Xanh than sáng hơn */
    border-color: #64748b;
}

/* ===== NHÓM THÊM THẺ MỚI ===== */
QGroupBox {
    background-color: rgba(15, 23, 42, 0.9); /* Xanh đen trong suốt */
    border: 1px solid #334155; /* Xám xanh */
    border-radius: 10px;
    color: #cbd5e1;
    font-size: 14px;
}

QGroupBox::title {
    color: #60a5fa; /* Xanh sáng */
    subcontrol-origin: margin;
    left: 15px;
    padding: 0 10px;
    font-weight: 600;
}

/* ===== Ô NHẬP LIỆU ===== */
QLineEdit, QTextEdit {
    background-color: #1e293b; /* Xanh than */
    color: #f1f5f9; /* Trắng nhẹ */
    border: 1px solid #475569; /* Xám xanh */
    border-radius: 6px;
    padding: 8px;
    font-size: 14px;
    selection-background-color: #3b82f6;
}

QLineEdit:focus, QTextEdit:focus {
    border: 1px solid #3b82f6;
    background-color: #0f172a;
}

QLineEdit::placeholder, QTextEdit::placeholder {
    color: #94a3b8; /* Xám nhạt */
    font-style: italic;
}

/* ===== NÚT THÊM ===== */
QPushButton#btnAdd {
    background-color: #1e3a8a; /* Navy (giống nút chính) */
    border: 1px solid #3b82f6;
}

QPushButton#btnAdd:hover {
    background-color: #2563eb;
}

/* ===== MENU BAR ===== */
QMenuBar {
    background-color: #000000;
    color: #cbd5e1;
    border-bottom: 1px solid #334155;
}

QMenuBar::item:selected {
    background-color: rgba(59, 130, 246, 0.2);
    color: #60a5fa;
}

QMenu {
    background-color: #0f172a;
    color: #e2e8f0;
    border: 1px solid #334155;
}

QMenu::item:selected {
    background-color: #3b82f6;
    color: white;
}

/* ===== SCROLLBAR ===== */
QScrollBar:vertical {
    background-color: #1e293b;
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background-color: #475569;
    border-radius: 5px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #64748b;
}

/* ===== LABEL PHỤ ===== */
QLabel {
    color: #94a3b8;
    font-size: 13px;
}</string>
